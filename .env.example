# Copy to .env for local development. Never commit .env.
# In production these live in Google Secret Manager (see infra/deploy.sh).

ENV=development
APP_BASE_URL=http://localhost:8000
WEB_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
DATABASE_URL=postgresql+asyncpg://restaurant:restaurant@localhost:5432/restaurant

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Long random string; protects /internal endpoints and signs OAuth state.
INTERNAL_TOKEN=change-me-to-a-long-random-string

# Supabase (Project Settings > API). Leave empty locally to use dev sign-in ("dev:you@example.com").
SUPABASE_URL=
SUPABASE_JWT_SECRET=
DEV_AUTH_ENABLED=true

# Claude API (console.anthropic.com). Without it the app runs but chat returns "not configured".
ANTHROPIC_API_KEY=
MODEL_DEFAULT=claude-haiku-5-5
MODEL_DEEP=claude-sonnet-5-5
MONTHLY_AI_BUDGET_USD=5
# Customers and drivers chat on their own small budget (US$ per person per month).
PERSONAL_MONTHLY_AI_BUDGET_USD=0.5

# Clover developer app (sandbox first). Production for Canadian merchants:
#   CLOVER_API_BASE=https://api.clover.com  CLOVER_WEB_BASE=https://www.clover.com
CLOVER_APP_ID=
CLOVER_APP_SECRET=
CLOVER_API_BASE=https://apisandbox.dev.clover.com
CLOVER_WEB_BASE=https://sandbox.dev.clover.com
CLOVER_WEBHOOK_AUTH_CODE=

# Google Business Profile (OAuth client of type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notifications (all optional; unset channels are skipped)
RESEND_API_KEY=
EMAIL_FROM=Restaurant AI <alerts@yourdomain.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@yourdomain.com

# --- Ecosystem: customer ordering and the in-house delivery fleet -------------------------------
# Emails allowed to invite drivers and open the Fleet dashboard (comma separated).
PLATFORM_ADMIN_EMAILS=
# Delivery hub (Main St & Broadway, Vancouver) and service radius in km. Drivers are employees.
DELIVERY_HUB_LAT=49.2634
DELIVERY_HUB_LNG=-123.1007
DELIVERY_RADIUS_KM=20
DELIVERY_BASE_FEE_CENTS=399
DELIVERY_BASE_KM=3
DELIVERY_PER_KM_CENTS=75
# Fee the restaurant pays per order, in basis points (600 = 6%). Never above BC's 20% cap.
RESTAURANT_FEE_PICKUP_BP=600
RESTAURANT_FEE_DELIVERY_BP=1100
DEFAULT_DRIVER_WAGE_CENTS=2000
# Weather for sales forecasts. Open-Meteo's free API is non-commercial: in production weather is
# only fetched with a paid key (empty = forecasts without weather).
OPEN_METEO_API_KEY=
# Stripe secret key (sk_test_... first). Empty = orders are test payments and nothing is charged.
STRIPE_SECRET_KEY=

# --- Receiving: scanned supplier invoices ----------------------------------------------------
# Model that reads invoice photos and PDFs (empty = MODEL_DEFAULT). Each scan costs about a cent.
INVOICE_MODEL=
INVOICE_MAX_MB=10
# Invoice images are deleted after this many days; the lines read from them stay in the log.
INVOICE_FILE_DAYS=120
# Default level for the price-change alert (each restaurant can change it in Settings).
PRICE_CHANGE_THRESHOLD_PCT=3
