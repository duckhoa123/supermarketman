{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	# The service worker and app shell must never be cached long, so new deploys show up immediately.
	@fresh path /sw.js /index.html /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	# Built assets have content hashes in their names, so they can be cached for a year.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Single-page app: any unknown path loads index.html and the app's router takes over.
	try_files {path} /index.html
	file_server
}
